# Copy to .env and edit. See README.md for what each one does.

# Storage
INFRASCAN_DB_PATH=./data/infrascan.db
INFRASCAN_DATA_ROOT=./data
INFRASCAN_OUT_ROOT=./out

# Auth
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
INFRASCAN_SECRET_KEY=change-me-please-this-is-not-secure

# Cookie domain. Local: leave blank. Production: .infrascan-ai.com
INFRASCAN_COOKIE_DOMAIN=

# Pipeline (only set when running pipeline jobs)
INFRASCAN_PIPELINE_MODELS=./external

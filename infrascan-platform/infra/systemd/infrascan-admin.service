[Unit]
Description=InfraScan admin (uvicorn :8051)
After=network.target

[Service]
Type=simple
User=infrascan
WorkingDirectory=/opt/infrascan-platform
EnvironmentFile=/opt/infrascan-platform/.env
ExecStart=/opt/infrascan-platform/.venv/bin/uvicorn app.main_admin:app \
    --host 0.0.0.0 --port 8051 --workers 1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
